<Window x:Class="SDMate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SDMate | Service Desk"
        Height="760"
        Width="1180"
        MinHeight="640"
        MinWidth="980"
        Background="#F3F6F4"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#151A18" />
        <SolidColorBrush x:Key="MutedBrush" Color="#68736E" />
        <SolidColorBrush x:Key="LineBrush" Color="#DFE6E2" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#006950" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#008066" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="#FFF700" />
        <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />

        <Style x:Key="NavItemStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#E2EEEA" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#9BB8AE" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#A8B1AA" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}">
            <Grid Margin="20,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="7" Background="{StaticResource SecondaryBrush}">
                        <TextBlock Text="S" Foreground="{StaticResource PrimaryBrush}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SDMate" Foreground="White" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="SERVICE DESK" Foreground="#C5DAD2" FontSize="9" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="WORKSPACE" Foreground="#B4CCC3" FontSize="10" FontWeight="Bold" Margin="4,0,0,10" />

                <StackPanel Grid.Row="3">
                    <Button Style="{StaticResource NavItemStyle}" Background="{StaticResource PrimaryHoverBrush}" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="OV" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}" Width="27" />
                            <TextBlock Text="Overview" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItemStyle}" Margin="0,5,0,0" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="OF" FontSize="10" FontWeight="Bold" Foreground="#C5DAD2" Width="27" />
                            <TextBlock Text="Offboarding" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItemStyle}" Margin="0,5,0,0" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ON" FontSize="10" FontWeight="Bold" Foreground="#C5DAD2" Width="27" />
                            <TextBlock Text="Onboarding" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="4,0,4,2">
                    <Border Height="1" Background="#438675" Margin="0,0,0,14" />
                    <TextBlock Text="LOCAL WORKSTATION" Foreground="#B4CCC3" FontSize="9" FontWeight="Bold" />
                    <TextBlock Text="Reminder storage: user profile" Foreground="#E2EEEA" FontSize="11" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Service Desk" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                        <TextBlock Text="  /  " Foreground="#A9B0AA" FontSize="13" />
                        <TextBlock Text="Overview" Foreground="{StaticResource InkBrush}" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="#E6DE00" BorderThickness="1" Background="#FFFDB8" CornerRadius="15" Padding="11,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Admin sign-in required" Foreground="{StaticResource InkBrush}" FontSize="11" Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="34,30,34,32">
                    <TextBlock Text="Operations overview" Foreground="{StaticResource InkBrush}" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="Account lifecycle actions and pending deletion reminders" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,5,0,0" />

                    <Grid Margin="0,25,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="290" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="22">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Deletion reminders" Foreground="{StaticResource InkBrush}" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="Pending and overdue AD account follow-ups" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#EAF2EE" CornerRadius="12" Padding="9,4" VerticalAlignment="Center">
                                        <TextBlock Text="0 ACTIVE" Foreground="{StaticResource PrimaryBrush}" FontSize="9" FontWeight="Bold" />
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="0.9*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ACCOUNT" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Grid.Column="1" Text="REMINDER" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Grid.Column="2" Text="DUE DATE" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Grid.Column="3" Text="STATUS" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                </Grid>

                                <Grid Grid.Row="3" Margin="0,12,0,0">
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,30">
                                        <Border Width="42" Height="42" CornerRadius="21" Background="#EAF2EE" HorizontalAlignment="Center">
                                            <TextBlock Text="0" Foreground="{StaticResource PrimaryBrush}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="No pending reminders" Foreground="{StaticResource InkBrush}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,13,0,0" />
                                        <TextBlock Text="New reminders will appear here after offboarding." Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <Border Background="{StaticResource PrimaryBrush}" CornerRadius="6" Padding="20">
                                <StackPanel>
                            <TextBlock Text="OFFBOARDING" Foreground="#C5DAD2" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="Process a departing user" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="0,9,0,0" />
                                    <TextBlock Text="Guided, single-user workflow" Foreground="#E2EEEA" FontSize="12" Margin="0,5,0,16" />
                                    <Button Content="Start offboarding" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" HorizontalAlignment="Left" />
                                    <TextBlock Text="Available after admin authentication is connected." Foreground="#D1E1DA" FontSize="10" TextWrapping="Wrap" Margin="0,11,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="ONBOARDING" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="New user setup" Foreground="{StaticResource InkBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    <TextBlock Text="Requirements to be defined" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="LOCAL AUDIT" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,22,0,0" />
                    <TextBlock Text="Audit events are stored under the current Windows user profile." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
